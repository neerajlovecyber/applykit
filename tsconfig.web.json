{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "app/index.d.ts",
    "app/**/*",
    "components/**/*",
    "lib/**/*",
    "resources/**/*"
  ],
  "exclude": ["**/*.test.*", "references/**/*"],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "types": ["electron-vite/node"],
    "paths": {
      "@/*": ["./*"]
    }
  }
}
